{
  "name": "zoomies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "party"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "dev:party": "partykit dev",
    "deploy:party": "partykit deploy",
    "build": "npm --workspace shared run build && npm --workspace client run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared client --pretty",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "partykit": "^0.0.115",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
